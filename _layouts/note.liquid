---
layout: default
---
{%- comment -%}
notes（_posts/、/blog/）の記事ページ。2026-11-10 に diary（_layouts/diary.liquid）と同じ形にした。
テーマの post.liquid との違い:
- 本文の幅を diary と同じ 620px（.diary-content）にする（930px だと一行が長くて読みにくい）
- 上下に前後の記事へのナビ（← 古い記事 / notes / 新しい記事 →）。題は一行に収めて末尾を…で切る（.note-nav）
- 「Created on April 24, 2022」と年・タグの行をやめ、右寄せで「投稿日：2022年4月24日」だけ（タグ・カテゴリがあればその上）
- 記事末尾の関連記事欄はもともと _config.yml で切ってあるので書かない
- 左に記事内の見出し（h2・h3）のナビ（2026-11-10、本人の希望。diary の曜日ナビに当たる）。JS で #markdown-content の見出しから作り、見出しが 2 つ未満なら出さない。今いる節を色で示す。CSS は main.scss の .note-toc
toc・citation・related_publications・コメントはテーマと同じ扱いで残す。
_news もテーマの post レイアウトを使うので、post.liquid は上書きせず別レイアウトにした（_config.yml の defaults で posts に当てる）。
{%- endcomment -%}
{% assign last_date = page.last_modified_at | default: page.last_updated %}

{% if page._styles %}
  <!-- Page/Post style -->
  <style type="text/css">
    {{ page._styles }}
  </style>
{% endif %}

{%- capture note_nav -%}
    {% if page.previous %}
      <a href="{{ page.previous.url | relative_url }}" class="diary-nav-prev" title="{{ page.previous.title | escape }}">
        ← {{ page.previous.title }}
      </a>
    {% else %}
      <span class="diary-nav-prev"></span>
    {% endif %}
    <a href="{{ '/blog/' | relative_url }}" class="diary-nav-index">notes</a>
    {% if page.next %}
      <a href="{{ page.next.url | relative_url }}" class="diary-nav-next" title="{{ page.next.title | escape }}">
        {{ page.next.title }} →
      </a>
    {% else %}
      <span class="diary-nav-next"></span>
    {% endif %}
{%- endcapture -%}

<div class="post diary-content">
  <nav class="diary-nav note-nav">
    {{ note_nav }}
  </nav>

  <header class="post-header">
    <h1 class="post-title">{{ page.title }}</h1>
    {%- comment -%} diary の「diary / 2026week46」に当たる「notes / 2022」の行は出さない（2026-11-10 本人「不要」）。タグ・カテゴリがあるときだけ投稿日の上に出す {%- endcomment -%}
    {%- capture note_labels -%}
      {%- for tag in page.tags %}|<a href="{{ tag | slugify | prepend: '/blog/#tag=' | relative_url }}">#{{ tag }}</a>{% endfor -%}
      {%- for category in page.categories %}|<a href="{{ category | slugify | prepend: '/blog/category/' | relative_url }}">{{ category }}</a>{% endfor -%}
    {%- endcapture -%}
    {%- assign note_labels = note_labels | remove_first: '|' | replace: '|', ' &nbsp;&middot;&nbsp; ' -%}
    <p class="diary-posted">
      {%- if note_labels != '' %}{{ note_labels }}<br>{% endif -%}
      投稿日：{{ page.date | date: '%Y年%-m月%-d日' }}
      {%- if last_date %}<br>更新日：{{ last_date | date: '%Y年%-m月%-d日' }}{% endif -%}
    </p>
  </header>

  <nav class="note-toc" id="note-toc" aria-label="目次" hidden></nav>

  <article class="post-content">
    {% if page.toc and page.toc.beginning %}
      <div id="table-of-contents">
        {% toc %}
      </div>
      <hr>
    {% endif %}
    <div id="markdown-content">
      {{ content }}
    </div>
  </article>

  {% if page.citation %}
    {% include citation.liquid %}
  {% endif %}

  {% if page.related_publications %}
    <h2>References</h2>
    <div class="publications">
      {% bibliography --group_by none --cited_in_order %}
    </div>
  {% endif %}

  {% if site.plugins contains 'al_comments' %}
    {% include plugins/al_comments.liquid %}
  {% endif %}

  <nav class="diary-nav note-nav diary-nav-bottom">
    {{ note_nav }}
  </nav>
</div>

<script>
  (function () {
    var nav = document.getElementById("note-toc");
    var heads = Array.prototype.slice.call(document.querySelectorAll("#markdown-content h2[id], #markdown-content h3[id]"));
    if (!nav || heads.length < 2) return;
    var list = document.createElement("ul");
    var links = heads.map(function (h) {
      var li = document.createElement("li");
      if (h.tagName === "H3") li.className = "note-toc-sub";
      var a = document.createElement("a");
      a.href = "#" + encodeURIComponent(h.id);
      a.textContent = h.textContent.trim();
      li.appendChild(a);
      list.appendChild(li);
      return a;
    });
    nav.appendChild(list);
    nav.hidden = false;
    var ticking = false;
    function mark() {
      ticking = false;
      var current = -1;
      for (var i = 0; i < heads.length; i++) {
        if (heads[i].getBoundingClientRect().top <= 90) current = i;
      }
      links.forEach(function (a, i) {
        var on = i === current;
        a.classList.toggle("is-current", on);
        if (on) a.setAttribute("aria-current", "location");
        else a.removeAttribute("aria-current");
      });
    }
    window.addEventListener("scroll", function () {
      if (!ticking) { ticking = true; requestAnimationFrame(mark); }
    }, { passive: true });
    mark();
  })();
</script>
