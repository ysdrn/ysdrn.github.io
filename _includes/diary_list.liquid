{%- comment -%}
日記の一覧。/diary/（全部）と /diary/<series>/（シリーズだけ）で共用。
notes（/blog/）と同じ post-list の形。
題は front matter の title、なければ期間「2026/11/09–15」。メタ行は「2026w46 · 投稿日」（週の名前は ISO 年 + w + ISO 週番号）。
title がある週は期間をメタ行に出す。
（Jekyll は日付付きファイル名の文書に title を自動で入れる（slug の "46" など）ので、slug と同じ title は無いものとして扱う）
シリーズ名は一覧には出さない（週ページの投稿日の下にだけ出す。本人の希望）。
include.series を渡すとそのシリーズの週だけ出す。
{%- endcomment -%}
{% if include.series %}
  {% assign sorted = site.diary | where: "series", include.series | sort: "date" | reverse %}
{% else %}
  {% assign sorted = site.diary | sort: "date" | reverse %}
{% endif %}
<ul class="post-list diary-list">
{% for entry in sorted %}
  {% assign entry_ts = entry.date | date: "%s" | plus: 0 %}
  {% assign entry_end_ts = entry_ts | plus: 518400 %}
  {% assign entry_start_m = entry_ts | date: "%m" %}
  {% assign entry_end_m = entry_end_ts | date: "%m" %}
  {% capture week_id %}{{ entry.date | date: "%G" }}w{{ entry.date | date: "%V" | plus: 0 }}{% endcapture %}
  {% capture week_range %}{{ entry_ts | date: "%Y/%m/%d" }}–{% if entry_start_m == entry_end_m %}{{ entry_end_ts | date: "%d" }}{% else %}{{ entry_end_ts | date: "%m/%d" }}{% endif %}{% endcapture %}
  {% if entry.title and entry.title != "" and entry.title != entry.slug %}
    {% assign entry_title = entry.title %}
  {% else %}
    {% assign entry_title = nil %}
  {% endif %}
  {% if entry.description and entry.description != "" %}
    {% assign blurb = entry.description %}
  {% else %}
    {% assign blurb = entry.content | strip_html | replace: "<!-- day -->", " " | strip_newlines | strip | truncate: 90 %}
  {% endif %}
  <li>
    <h3><a class="post-title" href="{{ entry.url | relative_url }}">{% if entry_title %}{{ entry_title }}{% else %}{{ week_range }}{% endif %}</a></h3>
    {% if blurb != "" %}<p>{{ blurb }}</p>{% endif %}
    <p class="post-meta">{{ week_id }} &nbsp; &middot; &nbsp; {% if entry_title %}{{ week_range }}{% else %}{{ entry.date | date: "%Y年%-m月%-d日" }}{% endif %}</p>
  </li>
{% endfor %}
</ul>

{% if sorted.size == 0 %}
まだ日記はありません。
{% endif %}
