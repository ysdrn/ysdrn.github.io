{%- comment -%}
日記の一覧。/diary/（全部）と /diary/<series>/（シリーズだけ）で共用。
include.series を渡すとそのシリーズの週だけ出す。
{%- endcomment -%}
{% if include.series %}
  {% assign sorted = site.diary | where: "series", include.series | sort: "date" | reverse %}
{% else %}
  {% assign sorted = site.diary | sort: "date" | reverse %}
{% endif %}
<div class="diary-list">
{% assign current_year = "" %}
{% assign current_series = "" %}
{% for entry in sorted %}
  {% assign entry_year = entry.date | date: "%Y" %}
  {% if entry_year != current_year %}
  {% assign current_year = entry_year %}
  {% assign current_series = "" %}
  <h2>{{ current_year }}</h2>
  {% endif %}
  {%- comment -%}
  シリーズの区切り: 年の中でシリーズが変わったところに一度だけ名前を出す（行ごとには付けない）。
  シリーズ専用の一覧（include.series あり）では出さない。
  {%- endcomment -%}
  {% assign entry_series = entry.series | default: "" %}
  {% if include.series == nil and entry_series != current_series %}
    {% assign current_series = entry_series %}
    {% if entry_series != "" %}
      {% assign s = site.data.diary_series | where: "key", entry_series | first %}
      <p class="diary-series-heading">{% if s %}<a href="{{ '/diary/' | append: s.key | append: '/' | relative_url }}">{{ s.name }}</a>{% else %}{{ entry_series }}{% endif %}</p>
    {% endif %}
  {% endif %}

  {% assign entry_ts = entry.date | date: "%s" | plus: 0 %}
  {% assign entry_end_ts = entry_ts | plus: 518400 %}
  {% assign entry_start_m = entry_ts | date: "%m" %}
  {% assign entry_end_m = entry_end_ts | date: "%m" %}
  {% assign week_num = entry.date | date: "%V" | plus: 0 %}

  <div class="diary-entry">
    <span class="diary-week">w{{ week_num }}</span>
    <a href="{{ entry.url | relative_url }}">{% if entry_start_m == entry_end_m %}{{ entry_ts | date: "%m/%d" }}–{{ entry_end_ts | date: "%d" }}{% else %}{{ entry_ts | date: "%m/%d" }}–{{ entry_end_ts | date: "%m/%d" }}{% endif %}</a>
    {% if entry.description %} <small class="text-muted">— {{ entry.description }}</small>{% endif %}
  </div>
{% endfor %}
</div>

{% if sorted.size == 0 %}
まだ日記はありません。
{% endif %}
